{
  "name": "electron",
  "version": "1.0.0",
  "description": "electron app",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "check:pg": "node -e \"require('pg');require('pg-types');console.log('pg runtime ok')\"",
    "dist:win": "pnpm install --no-frozen-lockfile --config.node-linker=hoisted --config.shamefully-hoist=true && pnpm run check:pg && electron-builder --win nsis --x64",
    "dist:win-arm64": "pnpm install --no-frozen-lockfile --config.node-linker=hoisted --config.shamefully-hoist=true && pnpm run check:pg && electron-builder --win nsis --arm64",
    "dist:win-portable": "pnpm install --no-frozen-lockfile --config.node-linker=hoisted --config.shamefully-hoist=true && pnpm run check:pg && electron-builder --win portable --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pg-types": "^2.2.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "build": {
    "appId": "com.alemdar.inventoryqr",
    "productName": "Inventory QR Printer",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      "!*.log",
      "!IMG_*.png",
      "!IMG_*.jpg",
      "!IMG_*.jpeg"
    ],
    "extraMetadata": {
      "main": "index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "^24.13.3"
  }
}
